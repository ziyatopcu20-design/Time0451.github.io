<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Çizgi Roman & Manga Kitaplığım</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: sans-serif; background-color: #121212; color: #fff; padding: 15px; }

        /* Üst Header: Profil & Bağış */
        header { display: flex; justify-content: space-between; align-items: center; padding: 15px; background: #1e1e1e; border-radius: 8px; margin-bottom: 25px; }
        .profile { display: flex; align-items: center; gap: 10px; }
        .profile img { width: 45px; height: 45px; border-radius: 50%; }
        
        /* Bağış Butonu */
        .donate-btn { background: #ff4757; color: white; padding: 8px 15px; text-decoration: none; border-radius: 5px; font-weight: bold; }
        .donate-btn:hover { background: #ff6b81; }

        /* İçerik Alanı */
        h2 { margin-bottom: 15px; border-bottom: 2px solid #333; padding-bottom: 5px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; margin-bottom: 30px; }
        
        .card { background: #1e1e1e; border-radius: 8px; overflow: hidden; cursor: pointer; text-align: center; border: 1px solid #333; }
        .card img { width: 100%; height: 170px; object-fit: cover; }
        .card p { padding: 10px; font-size: 14px; font-weight: bold; }

        /* Okuyucu Ekranı (Popup Modal) */
        .reader-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; flex-direction: column; align-items: center; justify-content: center; }
        .reader-modal img { max-width: 95%; max-height: 75vh; object-fit: contain; }
        .reader-controls { margin-top: 15px; display: flex; gap: 15px; }
        .reader-btn { background: #333; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-size: 16px; cursor: pointer; }
        .close-btn { position: absolute; top: 15px; right: 20px; background: red; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; }
    </style>
</head>
<body>

    <header>
        <h1>Kitaplığım</h1>
        <div class="profile">
            <a href="https://ko-fi.com/" target="_blank" class="donate-btn">❤️ Bağış Yap</a>
            <img src="profil-resmin.jpg" alt="Profil">
        </div>
    </header>

    <h2>Orijinal Çizgi Romanlarım</h2>
    <div class="grid">
        <div class="card" onclick="openReader(['manga1/01.jpg', 'manga1/02.jpg', 'manga1/03.jpg'])">
            <img src="manga1/01.jpg" alt="Kapak">
            <p>Hikaye 1</p>
        </div>
    </div>

    <h2>Fan Mangaları</h2>
    <div class="grid">
        <div class="card" onclick="openReader(['fanmanga1/01.jpg', 'fanmanga1/02.jpg'])">
            <img src="fanmanga1/01.jpg" alt="Kapak">
            <p>Fan Manga 1</p>
        </div>
    </div>

    <div id="reader" class="reader-modal">
        <button class="close-btn" onclick="closeReader()">X Kapat</button>
        <img id="page-img" src="" alt="Sayfa">
        <div class="reader-controls">
            <button class="reader-btn" onclick="prevPage()">◀ Önceki</button>
            <span id="page-num" style="align-self: center;">1 / 1</span>
            <button class="reader-btn" onclick="nextPage()">Sonraki ▶</button>
        </div>
    </div>

    <script>
        let currentPages = [];
        let currentIndex = 0;

        function openReader(pages) {
            currentPages = pages;
            currentIndex = 0;
            updatePage();
            document.getElementById('reader').style.display = 'flex';
        }

        function closeReader() {
            document.getElementById('reader').style.display = 'none';
        }

        function updatePage() {
            document.getElementById('page-img').src = currentPages[currentIndex];
            document.getElementById('page-num').innerText = (currentIndex + 1) + " / " + currentPages.length;
        }

        function nextPage() {
            if (currentIndex < currentPages.length - 1) {
                currentIndex++;
                updatePage();
            }
        }

        function prevPage() {
            if (currentIndex > 0) {
                currentIndex--;
                updatePage();
            }
        }
    </script>
</body>
</html>

